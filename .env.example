# Copie para .env (que não é versionado) e troque as senhas.
# Use apenas letras e números nas senhas, pois elas compõem a URI de conexão.
# Exemplo para gerar uma senha: openssl rand -hex 16
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=troque-esta-senha-root
MONGO_APP_USERNAME=todo_app
MONGO_APP_PASSWORD=troque-esta-senha-app
