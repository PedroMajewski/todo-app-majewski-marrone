# Nginx do ToDo App: entrega a interface React e encaminha a API no mesmo endereço.
# Arquivo processado pelo entrypoint oficial do Nginx (envsubst): ${API_UPSTREAM}
# vem da variável de ambiente do container (padrão api:5000, definido no Dockerfile).

# Repassa o protocolo original (https) quando há um proxy TLS na frente (Caddy).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # DNS interno do Docker: o nome da API é resolvido a cada requisição,
    # então o Nginx inicia mesmo que a API ainda não esteja pronta.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    # Rotas da API preservadas: /todos e /todos/:id (GET, POST, PATCH, DELETE).
    location /todos {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Saúde da API, incluindo a conexão com o MongoDB.
    location = /health {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # Saúde do próprio Nginx (healthcheck do container).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Arquivos gerados pelo build têm hash no nome: podem ficar em cache.
    location /static/ {
        expires 30d;
    }

    # Aplicação de página única: qualquer outra rota devolve o index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
